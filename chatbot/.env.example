# Plantilla de variables de entorno del chatbot.
# Copia este archivo a .env (cp .env.example .env) y rellena los valores.
# El .env real NUNCA se sube a git (está en .gitignore).

# API key de OpenAI (obligatoria)
OPENAI_API_KEY=sk-...

# Modelo a usar (opcional; por defecto gpt-4o-mini, ver config.py)
OPENAI_MODEL=gpt-4o-mini

# Prompt de sistema del asistente (obligatorio).
# Define el rol, el tono y las reglas anti-inyección. El contenido de
# chatbot/knowledge/*.md se inyecta automáticamente como contexto.
SYSTEM_PROMPT="Eres el asistente del portfolio de Renzo Ramos. ..."
